float3x3(0.9367811084,0.189789772,-0.1265711188,0.06153647602,0.8152601719,0.1232030988,-0.375623554,1.127665043,0.2479582876),
};
static const float3 CVS_Separator[3] = {
float3(0.1083770394,0.8916230202,-1),
float3(-0.3150867522,-0.6849134564,1),
float3(1,-0.714623332,-0.2853764296),
};
float CVS_Decode(float x) { return x<=0.04045 ? x/12.92 : pow((x+0.055)/1.055,2.4); }
float CVS_Encode(float x) { x=saturate(x); return x<=0.0031308 ? x*12.92 : 1.055*pow(x,1.0/2.4)-0.055; }
void CVS_VS(uint id:SV_VertexID,out float4 pos:SV_Position,out float2 uv:TEXCOORD0) {
 uv=float2((id<<1)&2,id&2); pos=float4(uv*float2(2,-2)+float2(-1,1),0,1);
}
float4 CVS_PS(float4 pos:SV_Position,float2 uv:TEXCOORD0):SV_Target {
 float3 input=saturate(tex2D(CVS_Source,uv).rgb);
 float3 c=float3(CVS_Decode(input.r),CVS_Decode(input.g),CVS_Decode(input.b));
 float3 result=c;
 if(CVS_Type==3) result=lerp(c,dot(c,float3(0.2126,0.7152,0.0722)).xxx,CVS_Severity);
 else if(CVS_Model==2||(CVS_Model==0&&CVS_Type==2)) {
   int branch=dot(c,CVS_Separator[CVS_Type])<0?1:0;
   result=lerp(c,mul(CVS_Brettel[CVS_Type*2+branch],c),CVS_Severity);
 } else {
   float level=CVS_Severity*10;int lo=min(9,(int)floor(level));
   result=lerp(mul(CVS_Machado[CVS_Type*11+lo],c),mul(CVS_Machado[CVS_Type*11+lo+1],c),level-lo);
 }
 result=lerp(dot(result,float3(0.2126,0.7152,0.0722)).xxx,result,CVS_Saturation);
 result=(result*exp2(CVS_Exposure)-0.18)*CVS_Contrast+0.18;
 return float4(CVS_Encode(result.r),CVS_Encode(result.g),CVS_Encode(result.b),1);
}
technique ColorVisionSimulator {
 pass { VertexShader=CVS_VS; PixelShader=CVS_PS; }
}
