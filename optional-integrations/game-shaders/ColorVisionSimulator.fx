// Color Vision Simulator. MIT; Machado data via Colorspacious, Brettel via DaltonLens.
// See LICENSES and docs/SCIENCE.md. SDR sRGB only. Not tested in a game.
texture2D CVS_BackBuffer : COLOR;
sampler2D CVS_Source { Texture = CVS_BackBuffer; };
uniform int CVS_Type < ui_type = "combo"; ui_label = "Deficiency"; ui_items = "Protan\0Deutan\0Tritan\0Luminance grayscale (approximation)\0"; > = 1;
uniform int CVS_Model < ui_type = "combo"; ui_label = "Model"; ui_items = "Recommended\0Machado 2009\0Brettel 1997 (severity blend)\0"; > = 0;
uniform float CVS_Severity < ui_type = "slider"; ui_min = 0.0; ui_max = 1.0; ui_label = "Severity"; > = 1.0;
uniform float CVS_Saturation < ui_type = "slider"; ui_min = 0.0; ui_max = 2.0; ui_label = "Artistic saturation"; > = 1.0;
uniform float CVS_Exposure < ui_type = "slider"; ui_min = -2.0; ui_max = 2.0; ui_label = "Artistic exposure EV"; > = 0.0;
uniform float CVS_Contrast < ui_type = "slider"; ui_min = 0.0; ui_max = 2.0; ui_label = "Artistic contrast"; > = 1.0;
